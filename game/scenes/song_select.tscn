[gd_scene load_steps=2 format=3 uid="uid://songselect001"]

[ext_resource type="Script" path="res://scripts/ui/song_select.gd" id="1_ss"]

[node name="SongSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ss")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.07, 0.09, 0.12, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 36

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "RhythmGame"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.78, 0.88, 1)
text = "선곡"

[node name="PathLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.62, 0.72, 1)
text = "차트 폴더:"

[node name="ChartList" type="ItemList" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 280)
layout_mode = 2
size_flags_vertical = 3

[node name="DetailLabel" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
autowrap_mode = 3
text = "차트를 선택하세요"

[node name="ErrorLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.45, 0.45, 1)

[node name="ButtonRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PlayButton" type="Button" parent="Margin/VBox/ButtonRow"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
disabled = true
text = "플레이"

[node name="SettingsButton" type="Button" parent="Margin/VBox/ButtonRow"]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
text = "설정"

[node name="RefreshButton" type="Button" parent="Margin/VBox/ButtonRow"]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
text = "새로고침"

[connection signal="item_selected" from="Margin/VBox/ChartList" to="." method="_on_chart_list_item_selected"]
[connection signal="pressed" from="Margin/VBox/ButtonRow/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonRow/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonRow/RefreshButton" to="." method="_on_refresh_button_pressed"]
